#!/usr/bin/env bash

set -euo pipefail

OUT_DIR="${HOME}/Pictures/Screenshots"
mkdir -p "${OUT_DIR}"

FILE_NAME="$(date +%Y-%m-%d_%H-%M-%S).png"
CAPTURED_FILE="${OUT_DIR}/${FILE_NAME}"

if ! command -v satty >/dev/null 2>&1; then
  notify-send "satty is not installed"
  exit 1
fi

# Use grim + slurp instead of hyprshot
grim -g "$(slurp)" "${CAPTURED_FILE}"

if [[ ! -f "${CAPTURED_FILE}" ]]; then
  notify-send "Screenshot capture failed"
  exit 1
fi

satty --filename "${CAPTURED_FILE}" --output-filename "${CAPTURED_FILE}" --copy-command wl-copy
